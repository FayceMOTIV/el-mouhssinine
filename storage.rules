rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images des paramètres (header, logos) → admin uniquement en écriture
    // SÉCURITÉ: limite taille 5MB + images uniquement
    match /settings/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('actif', true) == true &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Fichiers des projets → admin uniquement en écriture
    // SÉCURITÉ: limite taille 10MB + images et PDF uniquement
    match /projets/{projetId}/fichiers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('actif', true) == true &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
    }

    // Refuser tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
