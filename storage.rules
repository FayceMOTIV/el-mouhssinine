rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images des paramètres (header, logos) → admin uniquement en écriture
    match /settings/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role != null;
    }

    // Fichiers des projets → admin uniquement en écriture
    match /projets/{projetId}/fichiers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role != null;
    }

    // Refuser tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
