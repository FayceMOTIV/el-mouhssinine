require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

# Required for Firebase native SDK with React Native
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'ElMouhssinine' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix deployment target + signing for all pods
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['CODE_SIGN_IDENTITY'] = ''
        config.build_settings['DEVELOPMENT_TEAM'] = '5ZR87TPM89'
        # Swift 6 strict concurrency fix for Xcode 16.4
        if target.name.start_with?("Expo") || target.name.start_with?("EX")
          config.build_settings["OTHER_SWIFT_FLAGS"] = "$(inherited) -Xfrontend -strict-concurrency=minimal"
        end
      end
    end

    # Fix fmt 11.0.2 "consteval not a constant expression" with Xcode 26 / iOS 26 SDK clang.
    # Patch the fmt header directly so FMT_USE_CONSTEVAL=0 applies to EVERY consumer
    # (app target + all pods), disabling compile-time format-string consteval check.
    fmt_headers = Dir.glob(File.join(installer.sandbox.root.to_s, 'fmt', 'include', 'fmt', '{base,core}.h'))
    fmt_headers.each do |header|
      contents = File.read(header)
      # fmt's own detection block (#elif defined(__cpp_consteval)) sets it to 1 on
      # Xcode 26 clang, overriding any external -D. Force the detection result to 0.
      if contents.include?('#  define FMT_USE_CONSTEVAL 1')
        File.chmod(0644, header)
        patched = contents.gsub('#  define FMT_USE_CONSTEVAL 1',
                                '#  define FMT_USE_CONSTEVAL 0  // forced off: Xcode 26 clang consteval incompat')
        File.write(header, patched)
        Pod::UI.puts "[fmt-patch] FMT_USE_CONSTEVAL forced to 0 in #{header}"
      end
    end
  end
end
